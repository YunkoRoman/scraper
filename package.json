{
  "name": "scraper-platform",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/cli/index.ts",
    "api": "tsx --env-file=.env src/api/server.ts",
    "api:dev": "tsx watch --env-file=.env src/api/server.ts",
    "client": "cd client && npm run dev",
    "start": "concurrently \"npm run api:dev\" \"npm run client\"",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=.env src/infrastructure/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/scripts/seedParsers.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.31.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-csv": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^24.41.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^1.6.0"
  }
}
